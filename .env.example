# stac-x settings. Copy to .env (or .env.local) and fill in the first section.
# Everything below it is optional. Lines starting with # are off.


# ---------------------------------------------------------------- Sources
# Where each environment's STAC lives. Required: an environment left unset
# reads nothing and its pages load empty.
#
# Each value is one or more entries, separated by commas or newlines:
#
#   s3://bucket/stac/catalog.json   a STAC catalog (catalog-v1.json and other
#                                   versioned names work too). It's followed
#                                   to its collections, and each collection
#                                   links to its stac-geoparquet file.
#   s3://bucket/stac/               every parquet file and catalog under it
#   s3://bucket/path/file.parquet   one parquet file
#   ./data/prod                     a local folder, read the same way
#
# The items are always GeoParquet. In a catalog, the .json files are only
# the index: titles, descriptions, assets and the link to each .parquet file.
# Collections that keep one JSON file per item aren't read. Pointing straight
# at parquet files works too, but collections then have no title or
# description unless the file carries them in its metadata.
#
# The first entry must be a catalog, folder or prefix, not a single file:
# a collection promoted into the environment is copied there. Sandbox is
# outside promotion, so nothing is ever copied into it.

# A local folder of .parquet files.
STAC_SOURCES_SANDBOX=./data/sandbox
# A STAC catalog whose collections each link to a .parquet file.
STAC_SOURCES_DEV=s3://my-bucket/stac-dev/catalog-v1.json
# An S3 prefix: every .parquet file under it.
STAC_SOURCES_TEST=s3://my-bucket/stac-test/
# A local folder of .parquet files.
STAC_SOURCES_PROD=./data/prod
# STAC_SOURCES, from before there were environments, is read as Development's
# when STAC_SOURCES_DEV isn't set.

# The environment the app's bare address opens: sandbox, dev, test or prod.
# Default dev, for a deployment whose Production is still empty; set prod
# once collections have been approved through. Read per request, so a
# restart picks it up with no rebuild.
#STAC_HOME_ENV=dev


# -------------------------------------------------------------------- AWS
# The SDK's usual credential chain applies: these keys, AWS_PROFILE, or an
# instance or task role. Without credentials, S3 sources can't be read and
# their pages load empty with a note.
#AWS_REGION=us-east-1
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
#AWS_PROFILE=

# The app asks the SDK's chain whether it has credentials before serving an
# S3 asset or preview, so a task or instance role is found on its own. Set
# this to 1 to skip that question and always try.
#STAC_ASSUME_AWS=1


# ------------------------------------------------------------------ Links
# Bucket View (Cloud View's bucket browser), for the button on each S3
# asset. Filled in from the asset's s3:// href: {bucket}, {key} (as a path)
# and {prefix} (the asset's folder, as a query value). Unset, there's no
# button.
#CLOUD_VIEW_URL=https://cloudview.example.com/projects/my-project/bucketview?bucket={bucket}&key={prefix}

# The site this app is deployed under, linked at the left of the header as
# "Portal / STAC". Unset, the header shows the wordmark alone.
#STAC_PORTAL_URL=https://portal.example.com/
#STAC_PORTAL_NAME=Portal


# -------------------------------------------------------------------- Map
# The area the deployment is about: a GeoJSON file of polygons (WGS84). The
# home map opens on it, outlines it and dims everything outside. The name is
# what the page calls it ("Fit to the South Platte basin"); unset, the file's
# `name` property is used. Without an area, the map opens on everything the
# catalog covers, with no outline. Read at startup, so changes need a restart.
#STAC_MAP_AREA=./areas/south-platte.geojson
#STAC_MAP_AREA_NAME=the South Platte basin


# --------------------------------------------------------------- Page text
# The browser tab title and the page description.
#STAC_TITLE=STAC
#STAC_DESCRIPTION=


# -------------------------------------------------------- Build time only
# Next bakes these into the build, so changing one means rebuilding (in
# Docker, pass them as --build-arg). Setting them at run time does nothing.

# The path the app is served under when it shares a domain. The published
# Docker image is built with /stac. Unset, the app answers at the root.
#NEXT_PUBLIC_BASE_PATH=/stac

# Basemap styles (MapLibre style JSON). Default to OpenFreeMap.
#NEXT_PUBLIC_MAP_STYLE_LIGHT=https://tiles.openfreemap.org/styles/positron
#NEXT_PUBLIC_MAP_STYLE_DARK=https://tiles.openfreemap.org/styles/dark

# Elevation tiles (terrarium encoding) for the relief on the homepage map.
# Set to nothing to turn relief off.
#NEXT_PUBLIC_MAP_TERRAIN=https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{x}/{y}.png


# ----------------------------------------------------------------- Tuning
# How often (seconds) the app checks whether a source file changed. Pages
# never wait on this check; they're served from memory while it runs.
# Default 30.
#STAC_REFRESH_SECONDS=30

# WSL with the repo on the Windows drive: poll for file changes every N ms so
# hot reload works. Leave unset otherwise.
#NEXT_WATCH_POLL_MS=1000
