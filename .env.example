# Where each environment's STAC lives. Comma or newline separated. Each entry
# is a STAC catalog.json (followed to its collections), an S3 prefix (ends
# with /), an S3 object, a local folder, or a local file. The first entry must
# be a catalog.json, folder or prefix: it's where a collection promoted into
# that environment is copied. An environment left unset reads nothing.
# Sandbox is outside promotion, so nothing is ever copied into it.
# STAC_SOURCES, if set, is read as Development's.
STAC_SOURCES_SANDBOX=./data/sandbox
STAC_SOURCES_DEV=s3://my-bucket/stac-dev/catalog.json
STAC_SOURCES_TEST=s3://my-bucket/stac-test/
STAC_SOURCES_PROD=./data/prod

# The area the deployment is about: a GeoJSON file of polygons (WGS84). The
# home map opens on it, outlines it and dims everything outside. Unset, the
# map opens on everything the catalog covers, with no outline. The name is
# what the page calls it ("Fit to the South Platte basin"); unset, the
# file's `name` property is used.
#STAC_MAP_AREA=./areas/south-platte.geojson
#STAC_MAP_AREA_NAME=the South Platte basin

# Shown in the browser tab.
#STAC_TITLE=STAC
#STAC_DESCRIPTION=

# How often (seconds) a source's ETag is rechecked. Default 30.
#STAC_REFRESH_SECONDS=30

# WSL with the repo on the Windows drive: poll for file changes every N ms so
# hot reload works. Leave unset otherwise.
#NEXT_WATCH_POLL_MS=1000

# AWS. The SDK's default credential chain applies: env keys, a profile, an
# instance or task role. Nothing here means local files only.
#AWS_REGION=us-east-1
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
# Set this to 1 when credentials come from somewhere the app cannot see, such
# as an EC2 instance role, so it still tries S3 for assets and previews.
#STAC_ASSUME_AWS=1

# Cloud View, for the button on each S3 asset. {bucket} and {key} are filled
# in from the asset's s3:// href. Unset, the button shows but is disabled.
#CLOUD_VIEW_URL=https://cloudview.example.com/browse/{bucket}/{key}

# Basemap styles (MapLibre style JSON). Defaults to OpenFreeMap.
#NEXT_PUBLIC_MAP_STYLE_LIGHT=https://tiles.openfreemap.org/styles/positron
#NEXT_PUBLIC_MAP_STYLE_DARK=https://tiles.openfreemap.org/styles/dark

# Elevation tiles (terrarium encoding) for the relief on the homepage map.
# Set it to nothing to turn relief off.
#NEXT_PUBLIC_MAP_TERRAIN=https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{x}/{y}.png
